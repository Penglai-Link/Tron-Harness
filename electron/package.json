{
  "name": "tron-desktop-electron",
  "version": "0.1.0-SNAPSHOT",
  "private": true,
  "main": "main/index.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --dir",
    "package": "electron-builder --publish never",
    "ensure-electron": "node scripts/ensure-electron.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tron.desktop",
    "publish": null,
    "productName": "Tron",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main/**/*",
      "preload/**/*",
      "injection/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "mac": {
      "target": ["dmg"],
      "identity": null,
      "icon": "../src-tauri/icons/icon.icns"
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "unicode": true,
      "runAfterFinish": true
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}
