    "--tron-syntax-markup-italic": "var(--color-on-surface)",
    "--tron-syntax-storage-modifier-import": "var(--color-on-surface)",
    "--tron-syntax-carriage-return-text": "var(--color-on-surface)",
    "--tron-syntax-markup-ignored-text": "var(--color-on-surface)",
    "--tron-syntax-comment": "var(--color-on-surface-variant)",
    "--tron-syntax-markup-heading": "var(--color-primary)",
    "--tron-terminal-white": "#83e8a0",
    "--tron-terminal-bright-white": "#6fffa0",
    "--tron-terminal-bright-black": "#65ad7b"
