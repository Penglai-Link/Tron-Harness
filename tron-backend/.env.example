# Copy this file to .env for local backend development.
TRON_BACKEND_BIND_ADDRESS=127.0.0.1
TRON_BACKEND_PORT=8080
TRON_BACKEND_DATABASE_URL=tron-backend/target/tron.sqlite3

TRON_AUTH_JWT_SECRET=tron-dev-jwt-secret
TRON_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
TRON_AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
TRON_AUTH_COOKIE_SECURE=false

# Enable only when a real GitHub OAuth App is configured.
TRON_AUTH_GITHUB_ENABLED=false
TRON_AUTH_GITHUB_CLIENT_ID=
TRON_AUTH_GITHUB_CLIENT_SECRET=
# For local Vite dev with same-origin /api proxy, register this callback in the GitHub OAuth App.
TRON_AUTH_GITHUB_REDIRECT_URI=http://localhost:5173/api/v1/auth/oauth2/callback/github
TRON_AUTH_GITHUB_NAME=GitHub
TRON_AUTH_GITHUB_SCOPE=read:user user:email

# Optional overrides for GitHub Enterprise or local mock verification.
TRON_AUTH_GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
TRON_AUTH_GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
TRON_AUTH_GITHUB_USER_API_URL=https://api.github.com/user
TRON_AUTH_GITHUB_EMAILS_API_URL=https://api.github.com/user/emails

# Keep the deterministic dev OAuth2 provider off in normal runtime.
TRON_AUTH_DEV_OAUTH2_ENABLED=false
TRON_AUTH_DEV_OAUTH2_NAME=OAuth2
