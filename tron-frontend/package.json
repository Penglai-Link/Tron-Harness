{
  "name": "tron",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "dev": "vite",
    "build": "npm run packages:build && tsc -b && vite build",
    "predev": "npm run packages:build",
    "preview": "vite preview",
    "test:unit": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest run packages src/domain/resource src/shared/lib",
    "typecheck": "tsc -b --pretty false",
    "version-packages": "changeset version",
    "packages:build": "turbo run build --filter='./packages/*'",
    "packages:pack": "npm pack --dry-run --workspaces",
    "packages:publish": "changeset publish"
  },
  "dependencies": {
    "@antv/g6": "^5.1.1",
    "@base-ui/react": "^1.6.0",
    "@chenglou/pretext": "^0.0.6",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tron/chat-core": "workspace:*",
    "@tron/chat-internal-adapter": "workspace:*",
    "@tron/chat-react": "workspace:*",
    "@tron/chat-terminal": "workspace:*",
    "@tron/chat-theme": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "github-markdown-css": "^5.9.0",
    "i18next": "^26.0.8",
    "lodash-es": "^4.18.1",
    "lucide-react": "^0.553.0",
    "pdfjs-dist": "^6.1.200",
    "postprocessing": "^6.39.1",
    "radix-ui": "^1.6.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "react-router": "^7.15.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/react": "^16.3.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "sass": "^1.100.0",
    "tailwindcss": "^4.2.4",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.8"
  }
}
