# Example frontend environment values. Copy to .env.local or export variables in the shell.
# Global frontend data source. Keep mock as the MVP default.
VITE_TRON_DATA_SOURCE=mock

# Base URL used when any module is switched to api.
# Empty means same origin; the Vite dev server proxies /api to the Rust backend target below.
VITE_TRON_API_BASE_URL=

# Dev-only proxy target used when VITE_TRON_API_BASE_URL is empty.
TRON_FRONTEND_API_PROXY_TARGET=http://127.0.0.1:8080

# Optional terminal scope overrides. By default the bottom terminal uses the
# active workspace and sends appCode as null, so the backend uses
# TRON_TERMINAL_WORKING_DIRECTORY. Set appCode to open an application-scoped terminal.
VITE_TRON_TERMINAL_WORKSPACE_CODE=
VITE_TRON_TERMINAL_APP_CODE=
# Leave unset to use the workspace default text model for command generation.
VITE_TRON_TERMINAL_MODEL_CODE=

# Optional per-module overrides.
# Set a module to api to call real endpoints while the rest of the app keeps mock data.
VITE_TRON_AUTH_DATA_SOURCE=mock
VITE_TRON_ADMIN_DATA_SOURCE=mock
VITE_TRON_AGENT_DATA_SOURCE=mock
VITE_TRON_APP_DATA_SOURCE=mock
VITE_TRON_AUTOMATION_DATA_SOURCE=mock
VITE_TRON_CHAT_DATA_SOURCE=mock
VITE_TRON_KNOWLEDGE_GRAPH_DATA_SOURCE=mock
VITE_TRON_MEMORY_DATA_SOURCE=mock
VITE_TRON_MODEL_DATA_SOURCE=mock
VITE_TRON_PROMPT_DATA_SOURCE=mock
VITE_TRON_RESOURCE_DATA_SOURCE=mock
VITE_TRON_SKILL_DATA_SOURCE=mock
VITE_TRON_TASK_DATA_SOURCE=mock
VITE_TRON_VARIABLE_DATA_SOURCE=mock
